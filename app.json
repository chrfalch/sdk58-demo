{
  "expo": {
    "name": "SDK 58",
    "slug": "sdk58-demo",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sdk58demo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ramimaalouf.sdk58demo",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ramimaalouf.sdk58demo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      "expo-app-intents",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "InboxWidget",
              "displayName": "Inbox",
              "description": "Unread mail from the SDK 58 demo. Mark it all read from the widget.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/demos/inbox-widget/inbox-widget.tsx"
              },
              "android": {
                "minWidth": 250,
                "minHeight": 180,
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/demos/inbox-widget/inbox-widget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    }
  }
}
